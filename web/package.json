{
  "private": true,
  "type": "module",
  "appMinNativeVersion": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier -w .",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "i18n:extract": "lingui extract --clean",
    "build:app": "vite build --mode app",
    "dev:app": "vite --mode app --host",
    "cap:sync": "npm run build:app && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android",
    "ios:run": "npm run cap:sync && CAP_SKIP_WEB_BUILD=1 scripts/run-ios-sim.sh",
    "android:run": "npm run cap:sync && CAP_SKIP_WEB_BUILD=1 cap run android",
    "ios:live": "cap run ios --live-reload --port 5173",
    "android:live": "cap run android --live-reload --port 5173",
    "ios:sim": "scripts/run-ios-sim.sh",
    "assets": "node scripts/generate-assets.mjs",
    "ios:device": "npm run cap:sync && CAP_SKIP_WEB_BUILD=1 scripts/run-ios-device.sh",
    "ios:ipa": "npm run cap:sync && CAP_SKIP_WEB_BUILD=1 scripts/build-ios-ipa.sh",
    "ios:testflight": "npm run cap:sync && CAP_SKIP_WEB_BUILD=1 scripts/upload-ios-testflight.sh",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "^8.54.2",
    "@floating-ui/dom": "^1.8.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@preact/signals": "^1.3.1",
    "chart.js": "^4.6.1",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "chartjs-plugin-annotation": "^3.1.0",
    "daisyui": "^5.5.20",
    "dayjs": "^1.11.23",
    "idb": "^8.0.4",
    "preact": "^10.22.1",
    "preact-fetching": "^1.0.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-preact": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "vite": "^8.3.5"
  }
}
